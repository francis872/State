# Base de datos (PostgreSQL - recomendado: Neon.tech para producción)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/stateos_db?schema=public"

# JWT — cambia por un secreto largo y aleatorio en producción
JWT_SECRET="supersecretkey_change_in_production"

# Puerto del servidor
PORT=4000

# ─── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_REPLACE_WITH_YOUR_KEY"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_WITH_YOUR_SECRET"
STRIPE_BASIC_PRICE_ID="price_REPLACE_BASIC"
STRIPE_PRO_PRICE_ID="price_REPLACE_PRO"
STRIPE_ENTERPRISE_PRICE_ID="price_REPLACE_ENTERPRISE"

# ─── WhatsApp Business API (Meta Cloud API) ──────────────────
WHATSAPP_TOKEN="REPLACE_WITH_META_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="REPLACE_WITH_PHONE_NUMBER_ID"
WHATSAPP_VERIFY_TOKEN="stateos_whatsapp_verify_token"

# ─── Sentry ──────────────────────────────────────────────────
SENTRY_DSN_BACKEND="https://REPLACE@oXXXXXXX.ingest.sentry.io/XXXXXXX"
